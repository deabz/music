DISCORD_TOKEN=

# Register commands instantly in one server while developing.
GUILD_ID=YOUR_SERVER_ID

# Required for Spotify track/playlist/album metadata.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional YouTube cookies file for hosts where YouTube requires sign-in verification.
# Keep the file private; do not commit it.
YOUTUBE_COOKIES_FILE=

# Optional: automatically join this voice channel and remain deafened.
VOICE_CHANNEL_ID=YOUR_VOICE_CHANNEL_ID
VOICE_GUILD_ID=YOUR_SERVER_ID
AUTO_JOIN_VOICE=true

# Optional web health endpoint for Render/Railway/VPS monitors.
PORT=3000

# Set a long, random secret to enable the protected website music controls.
MUSIC_DASHBOARD_TOKEN=

# Queue and playback tuning.
DEFAULT_VOLUME=100
LEAVE_ON_EMPTY=false
EMPTY_CHANNEL_TIMEOUT_SECONDS=300
MAX_QUEUE_SIZE=1000
MUSIC_STATE_FILE=data/music-state.json

# Optional: use Supabase instead of the JSON file when both values are set.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
