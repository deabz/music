# Required: Discord bot credential, supplied privately in the host dashboard.
# DISCORD_TOKEN=
# Optional: guild-specific registration; blank means global commands.
# GUILD_ID=
# Optional: Spotify metadata client ID (both Spotify fields required for Spotify URLs).
# SPOTIFY_CLIENT_ID=
# Optional: Spotify metadata secret.
# SPOTIFY_CLIENT_SECRET=
# Optional: read-only Secret File copied to a writable private temp file.
# YOUTUBE_COOKIES_FILE=
# Optional: yt-dlp proxy URI; treated as a secret and never logged.
# YTDLP_PROXY=
# Optional: bounded diagnostics after ready (default true).
# STARTUP_DIAGNOSTICS=true
# Optional: channel to auto-join.
# VOICE_CHANNEL_ID=
# Optional: guild to auto-join; defaults to GUILD_ID.
# VOICE_GUILD_ID=
# Optional: join the configured voice channel (default true).
# AUTO_JOIN_VOICE=true
# Optional: supplied by Render; local default 3000, Docker default 10000.
# PORT=3000
# Optional: private random credential enabling dashboard controls.
# MUSIC_DASHBOARD_TOKEN=
# Optional: base server volume, 0-200 (default 80).
# DEFAULT_VOLUME=80
# Optional: leave empty voice channels (default false).
# LEAVE_ON_EMPTY=false
# Optional: empty-channel delay in seconds (default 300).
# EMPTY_CHANNEL_TIMEOUT_SECONDS=300
# Optional: waiting queue limit, 1-2000 (default 2000).
# MAX_QUEUE_SIZE=2000
# Optional: off/fade/crossfade; crossfade warns and uses fade (default fade).
# TRANSITION_MODE=fade
# Optional: total transition duration, 1-12 seconds (default 4).
# TRANSITION_SECONDS=4
# Optional: playback snapshot file (default data/music-state.json).
# MUSIC_STATE_FILE=data/music-state.json
# Optional: remote snapshot endpoint; requires a server-side key.
# SUPABASE_URL=
# Optional: preferred server-side Supabase secret.
# SUPABASE_SECRET_KEY=
# Optional: legacy server-side key if the preferred secret is absent.
# SUPABASE_SERVICE_ROLE_KEY=
# Optional: production enables static asset cache revalidation.
# NODE_ENV=production
# Optional: revision normally injected by Render, shown in diagnostics.
# RENDER_GIT_COMMIT=
# Optional: revision fallback on other hosts.
# GIT_COMMIT=

# Changelog page source (regenerated on GitHub on every push to main). Empty = bundled web/changelog.json only.
# CHANGELOG_URL=https://raw.githubusercontent.com/deabz/music/main/web/changelog.json
